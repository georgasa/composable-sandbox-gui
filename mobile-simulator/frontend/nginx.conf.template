# BACKEND_HOST/BACKEND_PORT are envsubst'd at container start by the
# official nginx image's built-in template mechanism. Defaults match the
# local Docker Compose service name; Azure sets BACKEND_HOST to the
# mobile-backend Container App's internal FQDN instead.
server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Lazy per-request DNS resolution via this container's actual resolver
    # (RESOLVER_IP, set by docker-entrypoint.d/05-set-resolver.envsh) --
    # see console-app/frontend/nginx.conf.template for why (nginx otherwise
    # crashes on startup if BACKEND_HOST isn't resolvable yet).
    resolver ${RESOLVER_IP} valid=10s;

    # proxy_ssl_server_name on -- see console-app/frontend/nginx.conf.template
    # for why (SNI for the TLS-layer routing Envoy also does on Azure).
    proxy_ssl_server_name on;

    # No URI on proxy_pass here -- see console-app/frontend/nginx.conf.template
    # for why (a variable in proxy_pass disables location-prefix rewriting,
    # so the original /api/... request URI passes through unchanged, which
    # is correct since the backend's routes are already mounted under /api).
    # proxy_http_version 1.1 -- see console-app/frontend/nginx.conf.template
    # for why (Azure Container Apps' ingress rejects nginx's default
    # HTTP/1.0 upstream proxying with a bare 426 Upgrade Required).
    # proxy_set_header Host ${BACKEND_HOST} (NOT $host) -- see
    # console-app/frontend/nginx.conf.template for why (Container Apps'
    # internal ingress routes by Host header; forwarding the frontend's own
    # Host makes Envoy unable to match any app and return a generic 404).
    # BACKEND_SCHEME (http locally, https on Azure) -- see
    # console-app/frontend/nginx.conf.template for why (Container Apps'
    # internal ingress is HTTPS-only; a plain http:// proxy_pass gets a
    # redirect nginx can't auto-rewrite here, and it leaks straight to the
    # browser as a CORS-blocked cross-origin request to the internal FQDN).
    location /api/ {
        set $backend "${BACKEND_HOST}:${BACKEND_PORT}";
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host ${BACKEND_HOST};
        proxy_pass ${BACKEND_SCHEME}://$backend;
        proxy_read_timeout 120s;
    }

    location /healthz {
        set $backend "${BACKEND_HOST}:${BACKEND_PORT}";
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host ${BACKEND_HOST};
        proxy_pass ${BACKEND_SCHEME}://$backend;
    }

    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location / {
        add_header Cache-Control "no-cache";
        try_files $uri /index.html;
    }
}
