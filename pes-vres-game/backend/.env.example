# Port the API listens on
PORT=3000

# AI_MODE controls which evaluator answers requests:
#   mock -> deterministic local evaluator, no API calls, free to use while developing/testing the app
#   real -> calls the OpenAI API to semantically judge answers
# The mobile app can also request a mode per-request (dev toggle); this is only the server default
# and what "real" falls back to if the client doesn't ask for "mock".
AI_MODE=mock

# Required when AI_MODE=real (or when a request asks for mode "real").
# NEVER put this key inside the mobile app - it must only ever live here, server-side.
OPENAI_API_KEY=

# Optional overrides
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_MS=8000
