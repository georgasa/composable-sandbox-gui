# Copy this file to `.env` (same directory as docker-compose.yml) and fill
# in your key -- `.env` is git-ignored, never commit it. Docker Compose
# loads it automatically; no other config needed.
#
# Leave LLM_PROVIDER unset (or "ollama") to keep using the fully-local
# model -- these settings are then simply ignored.

LLM_PROVIDER=openai
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
